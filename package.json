{
  "name": "sisu-xlsx-reader",
  "version": "1.0.0",
  "description": "SISU vacancy search tool for Brazilian students",
  "main": "xlsx-reader.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:search": "node --test test/sisu-search.test.js",
    "test:data": "node --test test/sisu-data.test.js",
    "test:xlsx": "node --test test/xlsx-reader.test.js",
